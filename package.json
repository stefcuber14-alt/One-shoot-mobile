{
  "name": "one-shoot",
  "version": "1.1.0",
  "private": true,
  "description": "one shoot — шутер для телефонов(Android APK через Capacitor)",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('index.html','www/ONE_SHOOT_3.0.7_MAPS_ACHIEVEMENTS.html');\"",
    "android:sync": "npm run prepare-web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
